{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunOnlyTheProductionDeployDocumentOnTheAIVaultServer",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ssm:ap-south-1:<ACCOUNT_ID>:document/AIVault-Deploy-production",
        "arn:aws:ec2:ap-south-1:<ACCOUNT_ID>:instance/<INSTANCE_ID>"
      ]
    },
    {
      "Sid": "ReadTheResultOfThatCommand",
      "Effect": "Allow",
      "Action": ["ssm:GetCommandInvocation", "ssm:ListCommandInvocations"],
      "Resource": "*"
    }
  ]
}
