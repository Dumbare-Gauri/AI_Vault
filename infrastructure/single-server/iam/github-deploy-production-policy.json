{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunOnlyTheProductionDeployDocumentOnTheProductionServer",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ssm:ap-southeast-2:<ACCOUNT_ID>:document/AIVault-Deploy-production",
        "arn:aws:ec2:ap-southeast-2:<ACCOUNT_ID>:instance/<PRODUCTION_INSTANCE_ID>"
      ]
    },
    {
      "Sid": "ReadTheResultOfThatCommand",
      "Effect": "Allow",
      "Action": ["ssm:GetCommandInvocation", "ssm:ListCommandInvocations"],
      "Resource": "*"
    }
  ]
}
