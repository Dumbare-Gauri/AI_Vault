[Unit]
Description=Stop the AI Vault staging server for the night
# Staging only: never stops a production server, even if installed there.
ConditionPathExists=/opt/aivault/staging
ConditionPathExists=!/opt/aivault/production

[Service]
Type=oneshot
# Skipped (and retried tomorrow) while a deployment holds the lock. The
# instance's shutdown behaviour is "stop", so it costs only its disk and IP
# until the next staging deploy starts it again.
ExecStart=/usr/bin/flock -n /opt/aivault/staging/deploy.lock /usr/bin/systemctl poweroff
