# One copy per environment, outside the repository and readable by root
# only (chmod 600):
#   /opt/aivault/staging/.env
#   /opt/aivault/production/.env
# Never commit a filled-in copy. Staging and production must not share a
# single secret below.

# --- identity of this copy -------------------------------------------------
ENVIRONMENT_NAME=staging            # staging | production
APP_ENV_FILE=/opt/aivault/staging/.env
IMAGE_TAG=change-me                 # the git commit SHA being deployed

# --- public address ---------------------------------------------------------
# HTTPS is required for the app to start (README: "HTTPS"). Caddy (`edge`)
# gets the certificate for PUBLIC_HOST from Let's Encrypt; its DNS A record
# must point at this instance's Elastic IP before the first deploy.
#   staging:    staging.example.com     production: app.example.com
PUBLIC_HOST=staging.example.com
PUBLIC_URL=https://staging.example.com          # https:// + PUBLIC_HOST
PUBLIC_SCHEME=https
# nginx, on the server's loopback only — deploy.sh's health check.
WEB_PORT=8081                       # staging 8081, production 8080
# Leave unset: nginx then believes only Caddy (172.30.0.0/24) about the
# client address, so a client can't fake it with X-Forwarded-For.
# TRUSTED_PROXY_CIDR=
# Only if a CloudFront distribution is ever put in front: the secret it
# sends in X-Origin-Verify. Empty = no CloudFront.
ORIGIN_VERIFY_SECRET=

# --- data services (generate each with `openssl rand -hex 32`) --------------
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- archive cache: this environment's own private S3 bucket ----------------
# Keys of an IAM user allowed only s3:GetObject/PutObject/DeleteObject/
# ListBucket on this bucket.
ARCHIVE_BUCKET=aivault-staging-archives
AWS_REGION=ap-southeast-2
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# --- backups: this environment's own S3 bucket (versioned, private) ---------
# Keys of an IAM user allowed only s3:PutObject on
# arn:aws:s3:::<BACKUP_BUCKET>/<ENVIRONMENT_NAME>/* — upload, nothing else.
BACKUP_BUCKET=aivault-staging-backups
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=

# --- application secrets -----------------------------------------------------
# `openssl rand -hex 32`
JWT_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing it makes every stored Drive token unreadable: back it up separately.
CONNECTOR_ENCRYPTION_KEY=

# --- Google OAuth: this environment's own Cloud project ---------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_SCOPES=openid email profile https://www.googleapis.com/auth/drive

# --- AI model (optional; billed by the provider, not AWS) -------------------
COMPLETION_PROVIDER=extractive
COMPLETION_API_KEY=
COMPLETION_MODEL_NAME=

# --- capacity -----------------------------------------------------------------
# Measured (README "Capacity"): every API process and every busy worker
# process holds its own ~210 MB copy of the embedding model.
#   production:  API_WORKERS=2  WORKER_CONCURRENCY=2  (peak ≈ 2.1 GB)
#   staging:     API_WORKERS=1  WORKER_CONCURRENCY=1  (peak ≈ 1.2 GB)
API_WORKERS=1
WORKER_CONCURRENCY=1
POSTGRES_MEM_LIMIT=512m
BACKEND_MEM_LIMIT=640m              # production with 2 API workers: 1g
WORKER_MEM_LIMIT=900m               # production with concurrency 2: 1536m
SCHEDULER_MEM_LIMIT=320m
ARCHIVE_FREE_SPACE_RESERVE_BYTES=2147483648
