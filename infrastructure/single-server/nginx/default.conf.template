# One per environment (staging, production): serves the built frontend and
# forwards the API on the same origin, so the refresh cookie, CORS and the
# Google OAuth callback all live on one address. Rendered at container
# start from environment variables (nginx image's /etc/nginx/templates).

# Which client address to believe. Requests that arrive straight from the
# internet (IP mode) are believed as they are: the default trusts no proxy,
# so a client can't fake its address with an X-Forwarded-For header. Behind
# CloudFront (HTTPS mode), set TRUSTED_PROXY_CIDR=0.0.0.0/0 — safe only
# because the security group then admits nothing but CloudFront — and the
# viewer address CloudFront appends is used.
set_real_ip_from ${TRUSTED_PROXY_CIDR};
real_ip_header X-Forwarded-For;
real_ip_recursive off;

server {
    listen 80;
    server_name _;
    server_tokens off;

    # Local Agent scan batches and archive uploads are larger than the default 1 MB.
    client_max_body_size 50m;

    # Behind CloudFront, CloudFront adds this header with a shared secret;
    # a request that reaches the server any other way is refused. Empty in
    # IP mode, where there is no CloudFront to add it.
    if ($http_x_origin_verify != "${ORIGIN_VERIFY_SECRET}") {
        return 403;
    }

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location /v1/ {
        proxy_pass http://${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # $remote_addr is the real client after the real_ip step above;
        # anything the client sent in X-Forwarded-For is replaced, not kept.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto ${PUBLIC_SCHEME};
        proxy_set_header X-Request-ID $request_id;
        # The origin secret stops here: the API never sees it, so it can't
        # end up in an application log or error report.
        proxy_set_header X-Origin-Verify "";
        # API answers are per person and never cacheable — said by the origin
        # itself, so a CloudFront misconfiguration still can't cache them.
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        # Extracting or emptying Trash can take minutes; the agent's long
        # poll holds a request open for up to 25 seconds.
        proxy_read_timeout 660s;
        proxy_send_timeout 660s;
        proxy_buffering off;
    }

    location = /health/live {
        proxy_pass http://${BACKEND_UPSTREAM};
        access_log off;
    }

    # Everything else is the single-page app; unknown paths fall back to it
    # so client-side routes (/files, /connectors/google/callback) load.
    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }

    # The app shell is re-read every time, so a release reaches people at once;
    # what it loads lives under /assets with content-hashed names.
    location = /index.html {
        root /usr/share/nginx/html;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    location /assets/ {
        root /usr/share/nginx/html;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
